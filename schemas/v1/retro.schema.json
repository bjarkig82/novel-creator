        },
        "exchange_id": {
          "type": "string",
          "format": "uuid"
        },
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "expected_head": {
          "type": "string"
        },
        "payload_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "assistant_text_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "notices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "notice_id": {
                "type": "string",
                "format": "uuid"
              },
              "start_byte": {
                "type": "integer",
                "minimum": 0
              },
              "end_byte": {
                "type": "integer",
                "minimum": 0
              },
              "text_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "notice_id",
              "start_byte",
              "end_byte",
              "text_digest"
            ],
            "additionalProperties": false
          }
        },
        "state": {
          "enum": [
            "reserved",
            "included",
            "released"
          ]
        }
      },
      "required": [
        "retro_version",
        "document",
        "reservation_id",
        "exchange_id",
        "message_id",
        "expected_head",
        "payload_digest",
        "assistant_text_digest",
        "notices",
        "state"
      ],
      "additionalProperties": false
    },
    "begin": {
      "type": "object",
      "properties": {
        "host_kind": {
          "const": "codex"
        },
        "thread_id": {
          "type": "string"
        },
        "initiating_turn_id": {
          "type": "string"
        },
        "completion_exchange_id": {
          "type": "string",
          "format": "uuid"
        },
        "checkpoint": {
          "type": "string"
        }
      },
      "required": [
        "host_kind",
        "thread_id",
        "initiating_turn_id",
        "completion_exchange_id",
        "checkpoint"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "outcome": {
          "enum": [
            "no_action",
            "insufficient_evidence",
            "selected"
          ]
        },
        "category": {
          "enum": [
            "workflow",
            "documentation",
            "test",
            "runtime"
          ]
        },
        "problem": {
          "type": "string"
        },
        "reproduction": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
