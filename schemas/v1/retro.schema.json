{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novel-creator.local/schemas/retro-v1",
  "$defs": {
    "notice": {
      "type": "object",
      "properties": {
        "retro_version": {
          "const": 1
        },
        "document": {
          "const": "notice"
        },
        "notice_id": {
          "type": "string",
          "format": "uuid"
        },
        "text": {
          "type": "string"
        },
        "text_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "enum": [
            "pending",
            "reserved",
            "included"
          ]
        },
        "reservation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "included_exchange_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "enum": [
            "en",
            "is"
          ]
        },
        "notice_kind": {
          "enum": [
            "published",
            "insufficient",
            "problem"
          ]
        },
        "reason_code": {
          "type": "string"
        }
      },
      "required": [
        "retro_version",
        "document",
        "notice_id",
        "text",
        "text_digest",
        "url",
        "state",
        "reservation_id",
        "included_exchange_id",
        "language",
        "notice_kind",
        "reason_code"
      ],
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "properties": {
        "retro_version": {
          "const": 1
        },
        "document": {
          "const": "authorization"
        },
        "enabled": {
          "type": "boolean"
        },
        "grant_id": {
          "type": "string",
          "format": "uuid"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "novel_id": {
          "type": "string",
          "format": "uuid"
        },
        "novel_root": {
          "type": "string"
        },
        "checkout_root": {
          "type": "string"
        },
        "git_common_dir": {
          "type": "string"
        },
        "repository": {
          "const": "bjarkig82/novel-creator"
        },
        "github_login": {
          "type": "string"
        },
        "authorization_source": {
          "const": "direct_cli"
        }
      },
      "required": [
        "retro_version",
        "document",
        "enabled",
        "grant_id",
        "generation",
        "novel_id",
        "novel_root",
        "checkout_root",
        "git_common_dir",
        "repository",
        "github_login",
        "authorization_source"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "retro_version": {
          "const": 1
        },
        "document": {
          "const": "run"
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "task_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "completion_exchange_id": {
          "type": "string",
          "format": "uuid"
        },
        "checkpoint": {
          "type": "string"
        },
        "grant_id": {
          "type": "string",
          "format": "uuid"
        },
        "authorization_generation": {
          "type": "integer",
          "minimum": 0
        },
        "bindings": {
          "type": "object",
          "properties": {
            "checkout_root": {
              "type": "string"
            },
            "git_common_dir": {
              "type": "string"
            },
            "github_login": {
              "type": "string"
            }
          },
          "required": [
            "checkout_root",
            "git_common_dir",
            "github_login"
          ],
          "additionalProperties": false
        },
        "status": {
          "enum": [
            "claimed",
            "reviewing",
            "no_action",
            "insufficient_evidence",
            "selected",
            "preparing",
            "prepared",
            "validating",
            "validated",
            "publishing",
            "published",
            "blocked",
            "disabled",
            "duplicate",
            "abandoned"
          ]
        },
        "reason_code": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "finding": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "category": {
                  "enum": [
                    "workflow",
                    "documentation",
                    "test",
                    "runtime"
                  ]
                },
                "problem": {
                  "type": "string"
                },
                "reproduction": {
                  "type": "string"
                }
              },
              "required": [
                "category",
                "problem",
                "reproduction"
              ],
              "additionalProperties": false
            }
          ]
        },
        "contribution": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "base": {
                  "type": "object",
                  "properties": {
                    "branch": {
                      "type": "string"
                    },
                    "sha": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "branch",
                    "sha"
                  ],
                  "additionalProperties": false
                },
                "worktree": {
                  "type": "string"
                },
                "branch": {
                  "type": "string"
                },
                "stage": {
                  "enum": [
                    "not_started",
                    "push_intent",
                    "pushed",
                    "create_intent",
                    "publication_unknown",
                    "published",
                    "remote_observed"
                  ]
                },
                "commit": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "validation": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "tree": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        },
                        "body": {
                          "type": "string"
                        },
                        "title_digest": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        "body_digest": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        "checks": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "object",
                            "properties": {
                              "argv": {
                                "type": "array",
                                "minItems": 1,
                                "items": {
                                  "type": "string"
                                }
                              },
                              "exit_code": {
                                "const": 0
                              }
                            },
                            "required": [
                              "argv",
                              "exit_code"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "privacy_approved": {
                          "const": true
                        },
                        "synthetic_only": {
                          "const": true
                        },
                        "attempt_id": {
                          "type": "string",
                          "format": "uuid"
                        }
                      },
                      "required": [
                        "tree",
                        "title",
                        "body",
                        "title_digest",
                        "body_digest",
                        "checks",
                        "privacy_approved",
                        "synthetic_only"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "pr": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "number": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "url": {
                          "type": "string"
                        },
                        "head": {
                          "type": "string"
                        },
                        "base": {
                          "type": "string"
                        },
                        "sha": {
                          "type": "string"
                        },
                        "draft": {
                          "type": "boolean"
                        },
                        "repository": {
                          "const": "bjarkig82/novel-creator"
                        },
                        "body": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        },
                        "state": {
                          "enum": [
                            "open",
                            "closed"
                          ]
                        },
                        "merged": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "number",
                        "url",
                        "head",
                        "base",
                        "sha",
                        "draft",
                        "repository",
                        "body",
                        "title",
                        "state"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "fingerprint": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "public_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "diagnostics": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "attempt_id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "tree": {
                        "type": "string"
                      },
                      "state": {
                        "enum": [
                          "running",
                          "passed",
                          "failed",
                          "unavailable",
                          "interrupted"
                        ]
                      },
                      "checks": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "argv": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              },
                              "minItems": 1
                            },
                            "exit_code": {
                              "type": [
                                "integer",
                                "null"
                              ]
                            },
                            "state": {
                              "enum": [
                                "running",
                                "passed",
                                "failed",
                                "unavailable",
                                "interrupted"
                              ]
                            },
                            "stdout": {
                              "type": "object",
                              "properties": {
                                "path": {
                                  "type": "string",
                                  "pattern": "^diagnostics/[0-9a-f-]+/[0-9a-f-]+/[0-9]+\\.(stdout|stderr)$"
                                },
                                "digest": {
                                  "type": [
                                    "string",
                                    "null"
                                  ],
                                  "pattern": "^[0-9a-f]{64}$"
                                }
                              },
                              "required": [
                                "path",
                                "digest"
                              ],
                              "additionalProperties": false
                            },
                            "stderr": {
                              "type": "object",
                              "properties": {
                                "path": {
                                  "type": "string",
                                  "pattern": "^diagnostics/[0-9a-f-]+/[0-9a-f-]+/[0-9]+\\.(stdout|stderr)$"
                                },
                                "digest": {
                                  "type": [
                                    "string",
                                    "null"
                                  ],
                                  "pattern": "^[0-9a-f]{64}$"
                                }
                              },
                              "required": [
                                "path",
                                "digest"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "argv",
                            "exit_code",
                            "state",
                            "stdout",
                            "stderr"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "attempt_id",
                      "tree",
                      "state",
                      "checks"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "base",
                "worktree",
                "branch",
                "stage",
                "commit",
                "validation",
                "pr",
                "fingerprint",
                "public_id"
              ],
              "additionalProperties": false
            }
          ]
        },
        "notice": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "retro_version": {
                  "const": 1
                },
                "document": {
                  "const": "notice"
                },
                "notice_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "text": {
                  "type": "string"
                },
                "text_digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "state": {
                  "enum": [
                    "pending",
                    "reserved",
                    "included"
                  ]
                },
                "reservation_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "included_exchange_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "language": {
                  "enum": [
                    "en",
                    "is"
                  ]
                },
                "notice_kind": {
                  "enum": [
                    "published",
                    "insufficient",
                    "problem"
                  ]
                },
                "reason_code": {
                  "type": "string"
                }
              },
              "required": [
                "retro_version",
                "document",
                "notice_id",
                "text",
                "text_digest",
                "url",
                "state",
                "reservation_id",
                "included_exchange_id",
                "language",
                "notice_kind",
                "reason_code"
              ],
              "additionalProperties": false
            }
          ]
        },
        "remote_outcome": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "equivalent",
                "observed",
                "verified"
              ]
            },
            "pr": {
              "anyOf": [
                {
                  "$ref": "#/$defs/remote_pr"
                },
                {
                  "$ref": "#/$defs/remote_reference"
                }
              ]
            }
          },
          "required": [
            "kind",
            "pr"
          ],
          "additionalProperties": false
        },
        "comparison": {
          "type": "object",
          "properties": {
            "snapshot": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "equivalent_pr": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "upstream_fix_present": {
              "type": "boolean"
            },
            "approved": {
              "const": true
            }
          },
          "required": [
            "snapshot",
            "equivalent_pr",
            "upstream_fix_present",
            "approved"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "retro_version",
        "document",
        "run_id",
        "task_key",
        "completion_exchange_id",
        "checkpoint",
        "grant_id",
        "authorization_generation",
        "bindings",
        "status",
        "reason_code",
        "evidence_refs",
        "finding",
        "contribution",
        "notice"
      ],
      "additionalProperties": false
    },
    "index": {
      "type": "object",
      "properties": {
        "retro_version": {
          "const": 1
        },
        "document": {
          "const": "index"
        },
        "claims": {
          "type": "object",
          "patternProperties": {
            "^[0-9a-f]{64}$": {
              "type": "string",
              "format": "uuid"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "retro_version",
        "document",
        "claims"
      ],
      "additionalProperties": false
    },
    "owner": {
      "type": "object",
      "properties": {
        "retro_version": {
          "const": 1
        },
        "document": {
          "const": "owner"
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "grant_id": {
          "type": "string",
          "format": "uuid"
        },
        "novel_root": {
          "type": "string"
        }
      },
      "required": [
        "retro_version",
        "document",
        "run_id",
        "grant_id",
        "novel_root"
      ],
      "additionalProperties": false
    },
