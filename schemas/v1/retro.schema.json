              "type": "string"
            }
          }
        },
        "title": {
          "type": "string"
        },
        "body_file": {
          "type": "string"
        },
        "privacy_approved": {
          "const": true
        },
        "synthetic_only": {
          "const": true
        }
      },
      "required": [
        "checks",
        "title",
        "body_file",
        "privacy_approved",
        "synthetic_only"
      ],
      "additionalProperties": false
    },
    "reservation_input": {
      "type": "object",
      "properties": {
        "retro_version": {
          "const": 1
        },
        "reservation_id": {
          "type": "string",
          "format": "uuid"
        },
        "exchange_id": {
          "type": "string",
          "format": "uuid"
