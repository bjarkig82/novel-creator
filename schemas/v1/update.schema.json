{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:novel-creator:update:v1",
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "oid": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\u0000\\r\\n]).+$"},
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "document_version", "protocol_version", "source_installation_formats", "story_schema_versions", "retro_versions"],
      "properties": {
        "kind": {"const": "release"}, "document_version": {"const": 1}, "protocol_version": {"const": 1},
        "source_installation_formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": [1, 2]}},
        "story_schema_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"const": "1.0"}},
        "retro_versions": {"type": "array", "uniqueItems": true, "items": {"const": 1}}
      }
    },
    "active": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "document_version", "operation_id"],
      "properties": {"kind": {"const": "active"}, "document_version": {"const": 1}, "operation_id": {"$ref": "#/$defs/uuid"}}
    },
    "change": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "action", "before", "after", "before_mode", "after_mode"],
      "properties": {
        "path": {"$ref": "#/$defs/path"}, "action": {"enum": ["add", "replace", "remove"]},
        "before": {"type": ["string", "null"]}, "after": {"type": ["string", "null"]},
        "before_mode": {"enum": [null, "100644", "100755"]}, "after_mode": {"enum": [null, "100644", "100755"]}
      },
      "allOf": [
        {"if": {"properties": {"action": {"const": "add"}}}, "then": {"properties": {"before": {"type": "null"}, "before_mode": {"type": "null"}, "after": {"type": "string"}, "after_mode": {"type": "string"}}}},
        {"if": {"properties": {"action": {"const": "remove"}}}, "then": {"properties": {"after": {"type": "null"}, "after_mode": {"type": "null"}, "before": {"type": "string"}, "before_mode": {"type": "string"}}}},
        {"if": {"properties": {"action": {"const": "replace"}}}, "then": {"properties": {"before": {"type": "string"}, "after": {"type": "string"}, "before_mode": {"type": "string"}, "after_mode": {"type": "string"}}}}
      ]
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["project", "version", "filename", "sha256", "size", "url"],
      "properties": {
        "project": {"const": "novel-creator"}, "version": {"type": "string", "minLength": 1},
        "filename": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+\\.whl$"},
        "sha256": {"$ref": "#/$defs/digest"}, "size": {"type": "integer", "minimum": 1},
        "url": {"type": "string", "pattern": "^https://files\\.pythonhosted\\.org/"}
      }
    },
    "preview": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "document_version", "preview_id", "novel_id", "novel_root", "branch", "source_head", "source_manifest_digest", "source_version", "target_version", "fingerprint", "runtime_python", "runtime_fingerprint", "artifact", "bundle_digest", "changes", "target_manifest", "source_manifest"],
      "properties": {
        "kind": {"const": "preview"}, "document_version": {"const": 1},
        "preview_id": {"$ref": "#/$defs/uuid"}, "novel_id": {"$ref": "#/$defs/uuid"},
        "novel_root": {"type": "string", "minLength": 1}, "branch": {"type": "string", "pattern": "^refs/heads/"},
        "source_head": {"$ref": "#/$defs/oid"}, "source_manifest_digest": {"$ref": "#/$defs/digest"},
        "source_version": {"type": "string"}, "target_version": {"type": "string"},
        "fingerprint": {"$ref": "#/$defs/digest"}, "runtime_python": {"type": "string", "minLength": 1},
        "runtime_fingerprint": {"$ref": "#/$defs/digest"}, "artifact": {"$ref": "#/$defs/artifact"},
        "bundle_digest": {"$ref": "#/$defs/digest"}, "changes": {"type": "array", "items": {"$ref": "#/$defs/change"}},
        "target_manifest": {"type": "object"}, "source_manifest": {"type": "object"}
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "document_version", "operation_id", "preview", "state", "fence", "candidate", "index_baseline"],
      "properties": {
        "kind": {"const": "operation"}, "document_version": {"const": 1}, "operation_id": {"$ref": "#/$defs/uuid"},
        "preview": {"$ref": "#/$defs/preview"},
        "state": {"enum": ["prepared", "fenced", "replacing", "candidate_published", "verifying", "complete"]},
        "candidate": {"$ref": "#/$defs/oid"}, "index_baseline": {"type": "object", "additionalProperties": {"type": "string"}},
        "fence": {
          "type": "object", "additionalProperties": false,
          "required": ["token", "owner_pid", "owner_identity", "ownership_confirmed", "confirm_quiescent"],
          "properties": {
            "token": {"$ref": "#/$defs/uuid"}, "owner_pid": {"type": "integer", "minimum": 1},
            "owner_identity": {"type": "string", "minLength": 1}, "ownership_confirmed": {"type": "boolean"},
            "confirm_quiescent": {"type": "boolean"}
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"state": {"const": "prepared"}}}, "then": {"properties": {"fence": {"properties": {"ownership_confirmed": {"const": false}}}}}, "else": {"properties": {"fence": {"properties": {"ownership_confirmed": {"const": true}}}}}}
      ]
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/release"}, {"$ref": "#/$defs/active"},
    {"$ref": "#/$defs/preview"}, {"$ref": "#/$defs/operation"}
  ]
}
